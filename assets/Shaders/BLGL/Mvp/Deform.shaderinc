uniform vec3 mvp_origin=vec3(0.0);
uniform float mvp_yaw=0.0;
uniform float mvp_height=1.0;
uniform float mvp_sy=1.0;
uniform vec2 mvp_lean=vec2(0.0);
uniform float mvp_twist=0.0;
uniform float mvp_bulge=0.0;
vec3 mvp_rotate(vec3 p,float a){float c=cos(a),s=sin(a);return vec3(c*p.x-s*p.z,p.y,s*p.x+c*p.z);}
vec3 mvp_deform(vec3 w){
    vec3 p=mvp_rotate(w-mvp_origin,-mvp_yaw);
    float h=clamp(p.y/mvp_height,0.0,1.6),sy=max(mvp_sy,0.3);
    p.xz*=inversesqrt(sy)*(1.0+mvp_bulge*sin(3.14159*clamp(h,0.0,1.0)));
    p.y*=sy;p=mvp_rotate(p,mvp_twist*h);
    p.xz+=mvp_lean*pow(h,1.5)*mvp_height;
    return mvp_rotate(p,mvp_yaw)+mvp_origin;
}
