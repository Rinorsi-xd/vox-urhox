// NanoVG gamma-space RTs store premultiplied RGB. Canvas PNGs store straight
// sRGB. Unpremultiply BEFORE decoding sRGB, preserving worn transparent paint.
uniform sampler2D canvas_map : filter_linear, repeat_disable;
uniform float canvas_enabled = 0.0;
// Framebuffer row order differs between devices (even two GLES/WebGL ones).
// HangarPanels paints red at the canvas top-left and blue at its bottom-left;
// this is the texel-centre UV inside those 2x2 markers.
uniform vec2 canvas_marker = vec2(0.0);
vec4 hangar_canvas(vec2 uv) {
    float top = texture(canvas_map, canvas_marker).r;
    float bottom = texture(canvas_map, vec2(canvas_marker.x, 1.0 - canvas_marker.y)).r;
    uv.y = mix(uv.y, 1.0 - uv.y, step(0.5, bottom - top));
    // Never show the markers themselves.
    vec2 m = canvas_marker * 2.0;
    if (uv.x < m.x && (uv.y < m.y || uv.y > 1.0 - m.y)) return vec4(0.0);
    vec4 c = texture(canvas_map, uv);
    vec3 srgb = clamp(c.rgb / max(c.a, 0.00001), vec3(0.0), vec3(1.0));
    c.rgb = mix(srgb / 12.92, pow((srgb + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), srgb));
    return c;
}
