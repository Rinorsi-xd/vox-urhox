0,6.5,0],"quaternion":[0,0,0,1],"scale":[1,1,1],"visible":true,"model":39,"material":17,"shadow":true},{"parent":2,"position":[0,0.2,0],"quaternion":[0,0,0,1],"scale":[1,1,1],"visible":true},{"parent":32,"position":[0,-0.5,0],"quaternion":[1,0,0,6.123233995736766e-17],"scale":[1,1,1],"visible":true,"model":40,"material":18,"shadow":true},{"parent":32,"position":[0,0.55,0],"quaternion":[0,0,0,1],"scale":[1,1,1],"visible":true,"model":41,"material":17,"shadow":true},{"parent":2,"position":[0,7.05,0],"quaternion":[0,0,0,1],"scale":[1,1,1],"visible":true,"model":42,"material":21,"shadow":true},{"parent":2,"position":[0.5,8,0.2],"quaternion":[0,0,0,1],"scale":[1,1,1],"visible":true,"model":43,"material":17,"shadow":true},{"parent":2,"position":[-0.45,7,-0.1],"quaternion":[0,0,0,1],"scale":[1,1,1],"visible":true},{"parent":37,"position":[0,0.2,0],"quaternion":[0.29552020666133955,0,0,0.955336489125606],"scale":[1,1,1],"visible":true,"model":44,"material":19,"shadow":true},{"parent":2,"position":[0,5.95,0],"quaternion":[0,0,0,1],"scale":[1,1,1],"visible":true},{"parent":39,"position":[0,0,0],"quaternion":[-0.7071067811865475,0,0,0.7071067811865476],"scale":[1,1,1],"visible":true,"model":45,"material":22,"shadow":false},{"parent":39,"position":[0,0,0],"quaternion":[-0.7071067811865475,0,0,0.7071067811865476],"scale":[1,1,1],"visible":true,"model":46,"material":23,"shadow":false},{"parent":39,"position":[0,0,0],"quaternion":[-0.7071067811865475,0,0,0.7071067811865476],"scale":[1,1,1],"visible":true,"model":47,"material":24,"shadow":false},{"parent":2,"position":[0,7.05,0],"quaternion":[0,0,0,1],"scale":[1,1,1],"visible":true},{"parent":2,"position":[0,7.2,0],"quaternion":[0,0,0,1],"scale":[1,1,1],"visible":true,"model":48,"material":25,"shadow":false},{"parent":2,"position":[0,0.2,0],"quaternion":[0,0,0,1],"scale":[1,1,1],"visible":true,"model":49,"material":26,"shadow":false}],"rig":{"body":2,"drill":32,"lamp":35,"halo":39,"flame":45,"up":44,"legs":[7,13,19],"rings":[41,42]}},"limitations":["Canvas halo sprites and mesh edge lines are not exported; original mesh silhouettes, beam/ring formulas and animation hierarchy are retained."]},"voices":{"S1-01":{"path":"Story/Mission/S1-01.ogg","text":["机修师？……喂，信号通了。还活着的话，就吱一声。"],"sha256":"4db82865e764918d605692f609e960c6ab16ad68053b3469dacdc8d31a36a63e"},"S1-02":{"path":"Story/Mission/S1-02.ogg","text":["很好，活着。CV-07 被打下来了，你现在就在它的货舱里。然后……公司让我第一时间转告你：设备损坏，从工资里扣。"],"sha256":"98cf9780f9605322d342c1bad6e00f8f4fb4e8d945b56095696c903a742b9c7b"},"S1-03":{"path":"Story/Mission/S1-03.ogg","text":["先去找黑匣子，它记着是谁打的我们。就在大厅中间，往前开就是。"],"sha256":"62586831aca6578a2853f9f36132c2419afe99de9f5515c235fa2834af470b28"},"S1-04":{"path":"Story/Mission/S1-04.ogg","text":["狐狸旗……是狐狐海盗团。好消息：他们以为舰上没人活着。坏消息：你活着。"],"sha256":"9dd08d2fef8d98e2d3a7acf5e6dc0b8a1b1f35c63d39dcfd874b17ab8a68c4f7"},"S1-05":{"path":"Story/Mission/S1-05.ogg","text":["大厅南边有个破口，从那儿出去。别找正门了——正门现在是天花板。"],"sha256":"2398648d8c7ea75951b277b2b5294b935ec28bfb8df557f99150fa4a70c688c9"},"S1-06":{"path":"Story/Mission/S1-06.ogg","text":["出来了。回头看一眼——那艘船有多大，你这周的工作量就有多大。"],"sha256":"7bc3af705b32d862f261580bbb4262df80bd4da765ef539f028d2c50231f277c"},"C-02":{"path":"Story/Mission/C-02.ogg","text":["诶~ 居然还有活口？运气真好呢，杂鱼~"],"sha256":"f15f22c600e327f349e58bbeebeb9301b643d7a462e2f1d1e197fef26a6b4674"},"S1-08":{"path":"Story/Mission/S1-08.ogg","text":["……刚才那段你就当没听见。"],"sha256":"36b763977d4da397403bc53786f9c2465a711c14e7db636d9e5daf2ae4d23601"},"S1-09":{"path":"Story/Mission/S1-09.ogg","text":["前哨站要你在三个点装采集器。第一个在舰顶甲板上，得绕到西高地，从栈桥开上去。"],"sha256":"369d91b25837f97710e2e8758b28d67fb9603ceb3089601eb5fffb7d0cfb2f68"},"S1-10":{"path":"Story/Mission/S1-10.ogg","text":["悬赏 12 信用点。……看来她自己也不太满意。"],"sha256":"945587ce613316e26dea9d89b1678fb1980ff87b9f48696216ab3050c3359fc1"},"S1-11":{"path":"Story/Mission/S1-11.ogg","text":["过了栈桥，开到甲板中间那个天窗边上。停稳，把采集器装上去。"],"sha256":"10b4e9a05a1fbbed222261aee8e8c63ed15eb49db435634eab82f116e0437793"},"S1-12":{"path":"Story/Mission/S1-12.ogg","text":["采集器 ① 上线，读数正常。公司说你干得不错——但不会因此给你加钱。"],"sha256":"2c5428e7d143102056e280fd7917522ba10ab1c9c3866e8cc9a919d63d50611b"},"S1-13":{"path":"Story/Mission/S1-13.ogg","text":["下一个点：舰首底下犁出来的那道沟。从甲板开下去，小心别摔——摔坏的零件也……算了，你知道的。"],"sha256":"2544efe6f9d3d9effb26d0043360c21e090bfc5418966a2ab7bf6a83a10508e9"},"S1-14":{"path":"Story/Mission/S1-14.ogg","text":["喂喂！你在本小姐的地盘上乱装什么东西啦！"],"sha256":"18b571141aa4ffc09e701e5d49dd59e01fd3477c64b8e79ccd3604796618ae2d"},"S1-15":{"path":"Story/Mission/S1-15.ogg","text":["采集器 ② 上线。最后一个在东洼地口。……她好像派人过去了。"],"sha256":"d73faa7de041c0eeabbd7842547ff70f452bdc4dc529facd59e7ea92fb24e732"},"S1-16":{"path":"Story/Mission/S1-16.ogg","text":["东洼地口在陨坑东边，从舰尾绕过去。……路上留神，那边刚才有信号。"],"sha256":"77690c358c91b71067fd084ed0d394385ed3bac124350c10b9584a828fe4c472"},"S1-20":{"path":"Story/Mission/S1-20.ogg","text":["呜……不、不算！刚才那是侦察队，又不是本小姐的主力！"],"sha256":"80d97522cec7722ae6da17cdfa605037696c2c5c5c90ecdee34e15cc0bf5625f"},"S1-19":{"path":"Story/Mission/S1-19.ogg","text":["哼，今天先放过你！侦察队，撤！"],"sha256":"679931d25627d7b93ac1dd178fe75377f1bcf43f7909b69c426455a539157cc9"},"S1-17":{"path":"Story/Mission/S1-17.ogg","text":["侦察队！给本小姐把那个杂鱼机修师赶走！"],"sha256":"ea287c74dbb717725d37effb21dba05698e444136a8d8d8707ba87f9ffb15d9f"},"S1-18":{"path":"Story/Mission/S1-18.ogg","text":["三艘海盗侦察艇。瞄准，开火——这个你总会吧。"],"sha256":"50cb99381c8a19550685cfda59ae17f564abcc674962fb4f2e9f0a2d7da8dc4c"},"S1-21":{"path":"Story/Mission/S1-21.ogg","text":["最后那艘掉了个东西。去捡起来看看，说不定值钱。"],"sha256":"25f33795a7c46e1c58a9f434efb19937a386dcb4990b974fce262106a4e081ee"},"S1-22":{"path":"Story/Mission/S1-22.ogg","text":["……火锅。行吧。"],"sha256":"e0b3b24acd779a092506b5d19c4259d8a3e608db71741febba9d87d88cff65e5"},"S1-23":{"path":"Story/Mission/S1-23.ogg","text":["好，把最后一台装上。"],"sha256":"78423ace9ecffe8fabe9fb70bc4b9115c3d95389f016c4b79b02535767c785dd"},"S1-24":{"path":"Story/Mission/S1-24.ogg","text":["三台全部上线。开回南边的要塞，我给你留了门——字面意义上的门。"],"sha256":"e6ab6ca6974b64e9fd9784dcfd8d3d528d9177025f62cd28832eda2ab8a0aa8d"},"S1-25":{"path":"Story/Mission/S1-25.ogg","text":["欢迎回来。……嗯，欢迎回来。任务完成。"],"sha256":"622170d192b456d224005eb02489bb4bf460f74811523e7d98e14e719ed8b65f"},"S1-26":{"path":"Story/Mission/S1-26.ogg","text":["公司决定奖励你一张「优秀员工」贴纸。贴纸的费用……我去帮你争取一下。"],"sha256":"5ab8e213ad8afd1aebfd989c1746ea3ae0bf42d32be1fdfdb0561e5b755a5049"},"S1-27":{"path":"Story/Mission/S1-27.ogg","text":["车没了。我从上个检查点又给你空投了一辆。空投费嘛……记你账上了。"],"sha256":"3c09bf53f7fdeda5be47676a5371eaccf007a402ab6a841aa609a11fc657d6dc"}}}