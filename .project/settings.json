{
  "$schema": "../schemas/settings.schema.json",
  "sources": {
    "engine": {
      "tag": "stable"
    },
    "engine-res": {
      "tag": "stable"
    },
    "official-res": {
      "tag": "stable"
    }
  },
  "build": {
    "generate_fs_path": true,
    "output_dir": "../dist",
    "asset_dirs": [
      "../assets",
      "../scripts"
    ],
    "asset_ignores": [
      "assets/Salvage/model-*",
      "assets/Salvage/collision-hull-?.bin*",
      "assets/Crater/albedo-?.png*",
      "assets/Crater/nra-?.png*",
      "assets/Crater/albedo-?.xml*",
      "assets/Crater/nra-?.xml*",
      "../assets/Crater/albedo-?.png*",
      "../assets/Crater/nra-?.png*",
      "../assets/Crater/albedo-?.xml*",
      "../assets/Crater/nra-?.xml*"
    ]
  },
  "@runtime": {
    "multiplayer": {
      "enabled": false
    }
  }
}