{
  "$schema": "../schemas/settings.schema.json",
  "sources": {
    "engine": {
      "tag": "stable"
    },
    "engine-res": {
      "tag": "stable"
    },
    "urhox-libs": {
      "tag": "1.0"
    },
    "official-res": {
      "tag": "stable"
    }
  },
  "build": {
    "generate_fs_path": true,
    "output_dir": "../dist",
    "asset_dirs": [
      "../assets",
      "../scripts"
    ],
    "asset_ignores": [
      "assets/Salvage/model-*",
      "assets/Salvage/collision-hull-?.bin*",
      "assets/Crater/albedo-?.png*",
      "assets/Crater/nra-?.png*",
      "assets/Crater/albedo-?.xml*",
      "assets/Crater/nra-?.xml*",
      "../assets/Crater/albedo-?.png*",
      "../assets/Crater/nra-?.png*",
      "../assets/Crater/albedo-?.xml*",
      "../assets/Crater/nra-?.xml*"
    ]
  },
  "@runtime": {
    "multiplayer": {
      "enabled": false,
      "max_players": 4,
      "background_match": false,
      "persistent_world": {
        "enabled": false
      },
      "match_info": {
        "desc_name": "free_match",
        "immediately_start": false,
        "match_timeout": 0,
        "player_number": 1
      }
    }
  }
}